# Copy to ".env" and fill in secrets. The file ".env" is gitignored.
# Spring Boot loads ".env" on startup (does not override existing OS env vars).

# --- Required for POST /api/v1/documents/word ---
OPENAI_API_KEY=

# Optional: same key under project-prefixed name (either works)
# DOCUMENT_READER_AI_API_KEY=

# --- AI provider (optional) ---
DOCUMENT_READER_AI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
DOCUMENT_READER_AI_MODEL=gpt-4o-mini

# --- PDF fetch limits (optional) ---
DOCUMENT_READER_PDF_MAX_BYTES=26214400
DOCUMENT_READER_PDF_MAX_PAGES=200
DOCUMENT_READER_PDF_FETCH_TIMEOUT_SECONDS=60
# Set to true only for local dev if you must use http:// PDF URLs
DOCUMENT_READER_PDF_ALLOW_INSECURE_HTTP=false

# --- Server (optional) ---
SERVER_PORT=8080
